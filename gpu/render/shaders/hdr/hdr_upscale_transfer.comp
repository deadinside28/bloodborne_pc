//
// bbport: the transfer around the upscaler, in place (hdr/upscale_transfer.glsl): the chain's
// gamma 2.2 frame decoded to linear BT.2020 for the reconstruction, and the reconstruction's
// result encoded back to the game's gamma 2.2 BT.709. Unlike shaders/fsr4_color.comp this one
// does not clamp to white: the above-white the chain made has to cross the upscaler.
// Ported from ports/lantern/nativeplus-engine.patch (hdr_upscale_transfer.comp).

#version 450

#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

#include "upscale_transfer.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

#ifdef BB_TRANSFER_ENCODE
// Back to the game's chain: in place, the upscaler's output image.
layout(binding = 0, rgba16f) uniform image2D target_img;
// Unused since the chain's frame travels whole (below): kept so the descriptor set the host binds
// stays the same shape.
layout(binding = 1) uniform texture2D chain_frame;
// The chain's own frame, output size, gamma 2.2: the whole value, above white included. This is
// the image the display pass reads instead of the game's 8-bit one, which cannot hold it (the
// reference's Native+ does the same: its reconstructed frame stays RGBA16F, nativeplus-engine
// .patch, generated_image/hudless_image).
layout(binding = 2, rgba16f) uniform writeonly image2D excess_out;
#else
// Into linear light for the reconstruction: the chain's frame -> a 16F image beside it.
layout(binding = 0) uniform texture2D source_img;
layout(binding = 1, rgba16f) uniform writeonly image2D target_img;
#endif

layout(push_constant) uniform Params {
    uint unused;
} params;

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(target_img)))) {
        return;
    }
#ifdef BB_TRANSFER_ENCODE
    const vec4 c = imageLoad(target_img, p);
    // The reconstruction's result, gamma 2.2 BT.709 with everything above white kept.
    const vec3 chain = bb_upscale_encode(c.rgb);
    // The display pass reads this image: it holds the chain's frame, so the light above the
    // game's white is carried in the value itself rather than encoded into an alpha (which the
    // reconstruction does not preserve, and which the game's own composite never writes).
    imageStore(excess_out, p, vec4(chain, 1.0));
    // The game's own image keeps what the game's later passes (UI, display copy) expect: white
    // is the top of the range it can hold.
    imageStore(target_img, p, vec4(clamp(chain, 0.0, 1.0), c.a));
#else
    const vec4 c = texelFetch(source_img, p, 0);
    imageStore(target_img, p, vec4(bb_upscale_decode(c.rgb), c.a));
#endif
}
